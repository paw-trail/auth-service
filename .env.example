# 이 파일을 복사해 .env 로 만들고 값을 채웁니다.
# .env 는 커밋되지 않습니다.
#
# 주의: .env 는 Docker Compose 가 읽는 파일입니다.
# IntelliJ 에서 서비스를 직접 실행할 때는 실행 구성(Run/Debug Configurations)의
# Environment variables 칸에 같은 값을 넣어야 합니다.
# 넣는 방법과 각 값의 뜻은 README 1-2 에 있습니다.

# -----------------------------------------------------------------------------
# 모든 도메인 서비스가 필요한 것
# -----------------------------------------------------------------------------

# 개발용 PostgreSQL
# 주소는 config 저장소의 application-local.yml 이 ${DB_HOST} 로 참조합니다.
# 지금은 각자 자기 컴퓨터에 띄웁니다(infra 의 db 프로파일). 그때 값은 localhost 입니다.
DB_HOST=localhost

# 서비스 전용 계정 10개가 공유하는 비밀번호입니다.
# infra 레포의 .env 에 넣은 SERVICE_DB_PASSWORD 와 같은 값이어야 합니다.
SERVICE_DB_PASSWORD=

# 공통 모듈 내려받기용 GitHub 계정
# Gradle 빌드에서 쓰이므로 OS 환경변수로 두는 것이 확실합니다.
# 토큰(classic)에 필요한 권한은 read:packages 입니다.
GPR_USER=
GPR_TOKEN=

# -----------------------------------------------------------------------------
# auth 만 필요한 것 — 셋 다 팀장에게 받습니다. 저장소 어디에도 없습니다.
# -----------------------------------------------------------------------------

# RS256 개인키를 Base64 한 줄로 만든 값
# 토큰에 서명합니다. 게이트웨이가 config 의 공개키로 검증하므로 팀에서 하나만 씁니다.
# 만드는 법과 갈아끼우는 법은 README 7-4 에 있습니다.
AUTH_JWT_PRIVATE_KEY_B64=

# Gmail 앱 비밀번호 (16자리, 띄어쓰기 없이)
# 인증 코드 메일을 보냅니다. 계정 비밀번호가 아니라 앱 비밀번호여야 합니다.
# 구글이 보여 주는 값은 4자리씩 띄어 있는데 붙여서 넣습니다.
AUTH_MAIL_PASSWORD=

# 구글 OAuth 클라이언트 시크릿
# 소셜 로그인의 토큰 교환에 씁니다. 클라이언트 ID 는 비밀이 아니라 config 저장소에 있습니다.
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=

# 아래 둘은 기본값이 있어 로컬에서는 비워 두어도 됩니다.
# CONFIG_HOST 를 지정하지 않으면 localhost:8888 을 봅니다.
# CONFIG_HOST=
# SPRING_PROFILES_ACTIVE=
